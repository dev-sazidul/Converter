# Copy to .env and change values before production.
# This file is safe to commit. Do not put real passwords here.

ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
STORAGE_DIR=./storage
MAX_FILE_SIZE_MB=25
MAX_TOTAL_SIZE_MB=100
MAX_FILES=20
MAX_PAGES=150
JOB_TTL_SECONDS=3600
CLEANUP_INTERVAL_SECONDS=300
MAX_IMAGE_PIXELS=40000000
ALLOWED_DPI=96,150,200

# Leave empty in local development so the Vite dev server proxies /api.
# In the Docker image the site and API share one origin, so this stays empty.
VITE_API_URL=

# Google AdSense. Leave the client empty to keep the demo images in each ad space.
# Paste one slot id per space after you create the units in AdSense.
# The popup is not an AdSense unit. Google does not allow AdSense in pop-ups.
# Replace the popup files in frontend/public/ads when you have your own creative.
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT_HEADER=
VITE_ADSENSE_SLOT_HOME=
VITE_ADSENSE_SLOT_CONTENT=
VITE_ADSENSE_SLOT_TOOL=
VITE_ADSENSE_SLOT_FOOTER=

# Reserved for a later accounts and job-history release.
# The app does not connect to Postgres or Redis in this version.
POSTGRES_USER=convarter
POSTGRES_PASSWORD=change-me
POSTGRES_DB=convarter
DATABASE_URL=postgresql://convarter:change-me@postgres:5432/convarter
REDIS_URL=redis://redis:6379/0
