# Copy to .env and change values before production.
# This file is safe to commit. Do not put real passwords here.

# Port where Compose publishes the site (Next.js). Put HTTPS in front of it in production.
HTTP_PORT=8080
# Largest upload Next.js accepts, in MB. Keep it a little above MAX_TOTAL_SIZE_MB.
MAX_REQUEST_MB=120

ENVIRONMENT=development
# Shared secret between Next.js and the Python converter. Set a long random value in
# production, for example from `openssl rand -hex 32`. Empty turns the check off.
CONVERTER_TOKEN=
STORAGE_DIR=./storage
MAX_FILE_SIZE_MB=25
MAX_TOTAL_SIZE_MB=100
MAX_FILES=20
MAX_PAGES=150
JOB_TTL_SECONDS=3600
CLEANUP_INTERVAL_SECONDS=300
MAX_IMAGE_PIXELS=40000000
ALLOWED_DPI=96,150,200
# LibreOffice, Ghostscript, and Chromium conversions stop after this many seconds.
CONVERSION_TIMEOUT_SECONDS=120
HTML_NAVIGATION_TIMEOUT_SECONDS=25
# Jobs that run at once, and how long a job waits for a free slot before the API says "busy".
MAX_CONCURRENT_JOBS=2
QUEUE_TIMEOUT_SECONDS=30
# Memory caps for the containers.
BACKEND_MEM_LIMIT=2g
FRONTEND_MEM_LIMIT=768m
# Optional absolute path to an sRGB ICC profile. Leave empty to use Ghostscript's profile.
PDFA_ICC_PATH=

# Public site origin used for canonical URLs, Open Graph, and the sitemap.
# Use the live domain for production builds. Override it for a local preview.
SITE_URL=https://bestconvert.site

# Where Next.js finds the converter. Compose sets http://backend:8000. This is the local default.
CONVERTER_URL=http://127.0.0.1:8000

# SQLite database for Next.js. Compose sets file:/data/db/app.db in the "database" volume.
# Locally it defaults to frontend/data/app.db. See docs/DATABASE.md before switching to Postgres.
# DATABASE_URL=file:./data/app.db

# Google AdSense. Leave the client empty to keep the demo images in each ad space.
# Paste one slot id per space after you create the units in AdSense.
# The popup is not an AdSense unit. Google does not allow AdSense in pop-ups.
# Replace the popup files in frontend/public/ads when you have your own creative.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_HEADER=
NEXT_PUBLIC_ADSENSE_SLOT_HOME=
NEXT_PUBLIC_ADSENSE_SLOT_CONTENT=
NEXT_PUBLIC_ADSENSE_SLOT_TOOL=
NEXT_PUBLIC_ADSENSE_SLOT_FOOTER=

# Reserved for later. The app uses SQLite and does not connect to Postgres or Redis yet.
POSTGRES_USER=convarter
POSTGRES_PASSWORD=change-me
POSTGRES_DB=convarter
REDIS_URL=redis://redis:6379/0
